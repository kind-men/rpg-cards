    "eslint": "^9.39.4",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.5.0",
    "mdsvex": "^0.12.7",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.6",
    "ts-node": "^10.5.0",
    "tslib": "^2.3.1",
    "typescript-eslint": "^8.59.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
